# Configuration du frontend MineBackfill (copier vers .env.local en dev).
#
# URL du backend FastAPI, utilisee par le proxy Next.js (next.config.ts) pour
# router /rpc, /rpg, /rrc vers le backend. En dev local, laisser vide : le
# proxy retombe sur http://127.0.0.1:8000.
#
# NB : ne PAS utiliser NEXT_PUBLIC_API_BASE (variable morte, jamais lue).
BACKEND_URL=
NEXT_PUBLIC_API_URL=

# Synchronisation en ligne (Supabase) — OPTIONNELLE.
# Sans ces deux variables, l'app fonctionne a 100 % en local (comportement
# actuel) : le lien « Compte » est masque, aucun appel reseau. Voir
# supabase/README.md pour la mise en place. Ces variables sont inlinees au
# build (NEXT_PUBLIC_*) : un changement exige un redeploiement.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
